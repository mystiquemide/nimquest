{
  "name": "nimquest",
  "version": "0.1.0",
  "private": true,
  "description": "Nimiq Pay mini app for onboarding quests with wallet-based completion proof.",
  "type": "module",
  "scripts": {
    "start": "node apps/api/src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "generate:web-catalog": "node scripts/generate-web-catalog.mjs",
    "prebuild:web": "npm run generate:web-catalog",
    "build:web": "vite build",
    "preview:web": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:worker-integration": "node scripts/worker-integration.mjs",
    "qa": "npm test && npm run build:web && npm run test:browser && npm run worker:check",
    "cli": "node cli/index.mjs",
    "doctor": "node cli/index.mjs doctor",
    "qa:cli": "node cli/index.mjs qa",
    "qa:full": "node cli/index.mjs qa full",
    "deploy:check": "node cli/index.mjs deploy check",
    "worker:types": "wrangler types",
    "worker:check": "npm run build:web && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@nimiq/core": "^2.7.1",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "^24.0.0",
    "playwright": "^1.61.1",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
